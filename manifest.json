{
  "manifest_version": 3,
  "name": "notif",
  "version": "0.4.0",
  "description": "Desktop notifications for iClicker and TopHat poll questions",

  "permissions": [
    "notifications",
    "storage",
    "tabs"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "notif"
  },

  "content_scripts": [
    {
      "matches": [
        "https://student.iclicker.com/*",
        "https://app.tophat.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "128": "icons/icon128.png"
  }
}
